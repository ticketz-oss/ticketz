+var (
+	fftTwiddleMu    sync.Mutex
+	fftTwiddleCache atomic.Pointer[map[int][]cpx]
+)
+
+func init() {
+	values := make(map[int][]cpx)
+	fftTwiddleCache.Store(&values)
+}
+
+// fftTwiddleMatrix caches the exact float32 angle expansion used by fftRec.
+// The transform sizes are fixed by the codec, so the matrices are built once
+// and then shared read-only by every call encoder.
+func fftTwiddleMatrix(n int, sign float32) []cpx {
+	key := n
+	if sign > 0 {
+		key = -n
+	}
+	cache := fftTwiddleCache.Load()
+	values := (*cache)[key]
+	if values != nil {
+		return values
+	}
+
+	fftTwiddleMu.Lock()
+	defer fftTwiddleMu.Unlock()
+	cache = fftTwiddleCache.Load()
+	if values = (*cache)[key]; values != nil {
+		return values
+	}
+	values = make([]cpx, n*n)
+	for k := 0; k < n; k++ {
+		angK := sign * 2.0 * smplPI * float32(k) / float32(n)
+		for j := 0; j < n; j++ {
+			ang := angK * float32(j)
+			values[k*n+j] = cpx{
+				re: float32(math.Cos(float64(ang))),
+				im: float32(math.Sin(float64(ang))),
+			}
+		}
+	}
+	next := make(map[int][]cpx, len(*cache)+1)
+	for cacheKey, cacheValues := range *cache {
+		next[cacheKey] = cacheValues
+	}
+	next[key] = values
+	fftTwiddleCache.Store(&next)
+	return values
+}
+
 func (a cpx) add(b cpx) cpx {
