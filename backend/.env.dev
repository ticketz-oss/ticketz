NODE_ENV=
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
#PROXY_PORT=8080
PORT=8080

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ticketz
#DB_PASS=
DB_NAME=ticketz
#DB_DEBUG=true

REDIS_URI=redis://127.0.0.1:6379
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

LOG_LEVEL=debug

# AbacatePay: quando definidas, estas variáveis têm prioridade sobre as chaves
# salvas em Configurações (_abacatePayToken / _abacatePayWebhookSecret).
# Deixe comentadas para usar as chaves de desenvolvimento salvas no banco.
#ABACATEPAY_TOKEN=abc_dev_...
#ABACATEPAY_WEBHOOK_SECRET=webh_dev_...

# WhatsApp Cloud API (Meta oficial) - ver plano em .claude/plans (App Meta
# for Developers, produto WhatsApp + Facebook Login for Business, Embedded
# Signup Configuration, App Review de whatsapp_business_management/messaging).
#META_APP_ID=
#META_APP_SECRET=
#META_CONFIG_ID=
#META_WEBHOOK_VERIFY_TOKEN=
#META_GRAPH_API_VERSION=v21.0
# CSV de companyId liberados pro modo "meta" (rollout restrito).
#META_ALLOWED_COMPANY_IDS=
# Chave usada para cifrar metaAccessToken em repouso (AES-256-GCM).
#ENCRYPTION_KEY=
