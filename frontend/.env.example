# Ticketz Frontend Configuration (Vite + React)
# Default behavior automatically adapts to the current browser origin (e.g. http://localhost:3000 or https://chat.example.com)

# Optional: Override backend URL explicitly if hosted on an external API domain
# VITE_BACKEND_URL=https://api.example.com/backend

# Optional: Port for local development (default 5173 for Vite dev server)
# PORT=5173
